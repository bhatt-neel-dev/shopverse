# Published host ports. Copy to `.env` in this directory and edit if any clash with
# something already running (`lsof -nP -iTCP:<port> -sTCP:LISTEN` to check).
# Container-internal ports never change — only the host side is remapped.

GATEWAY_PORT=8080
STOREFRONT_PORT=3000
STUDIO_API_PORT=9100     # 9000 is commonly taken (ClickHouse, MinIO, SonarQube, PHP-FPM)
STUDIO_UI_PORT=9001
LOCUST_PORT=8089
RABBITMQ_UI_PORT=15672

# Phase C device overlay (docker-compose.devices.yml)
APPLIANCE_IP=172.16.14.71
FLOW_IFACE=eth0
